<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Portfolio Audit - {{ generated_at }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Chart.js v4.4.4 (MIT) is inlined below so this report is a single file that
     renders with no network access - email it, archive it, open it offline. -->
<script>{{ chartjs|safe }}</script>
<style>
  :root {
    --bg: #0b0d10;
    --panel: #14171c;
    --panel-border: #262b33;
    --text: #e6e9ef;
    --text-dim: #8b93a1;
    --accent: #7cf29c;
    --accent-2: #ff9f6b;
    --danger: #ff6b7a;
    /* System stacks only - no webfont fetch, so the report needs no network. */
    --font-mono: 'JetBrains Mono', 'SFMono-Regular', 'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    --font-display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    margin: 0;
    padding: 32px 24px 64px;
  }
  header {
    max-width: 1200px;
    margin: 0 auto 32px;
    border-bottom: 1px solid var(--panel-border);
    padding-bottom: 20px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: 28px;
    margin: 0 0 6px;
    letter-spacing: -0.5px;
  }
  .subtitle { color: var(--text-dim); font-size: 13px; }
  .container { max-width: 1200px; margin: 0 auto; }
  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    margin-bottom: 28px;
  }
  .stat {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 16px;
  }
  .stat .value {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    color: var(--accent);
  }
  .stat .label { color: var(--text-dim); font-size: 12px; margin-top: 4px; }
  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 18px;
    margin-bottom: 32px;
  }
  .chart-card {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 18px;
  }
  .chart-card h3 { margin: 0 0 12px; font-size: 14px; color: var(--text-dim); font-weight: 600; }
  /* Fixed-height wrapper + maintainAspectRatio:false keeps every card the same
     size, instead of the grid stretching short charts to the doughnut's height. */
  .chart-wrap { position: relative; height: 260px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--panel-border); }
  th { color: var(--text-dim); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
  tr:hover { background: rgba(255,255,255,0.02); }
  .score { font-weight: 700; }
  .score.good { color: var(--accent); }
  .score.mid { color: var(--accent-2); }
  .score.bad { color: var(--danger); }
  .badge {
    display: inline-block;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 20px;
    margin-left: 6px;
  }
  .badge.stale { background: rgba(255,107,122,0.15); color: var(--danger); }
  .badge.archived { background: rgba(139,147,161,0.15); color: var(--text-dim); }
  .notes { color: var(--text-dim); font-size: 11px; }
  a { color: var(--accent); text-decoration: none; }
  section h2 { font-family: var(--font-display); font-size: 18px; margin-bottom: 12px; }
</style>
</head>
<body>
<header>
  <h1>&gt; Portfolio Audit</h1>
  <div class="subtitle">Generated {{ generated_at }} · {{ insights.total_repos }} repositories scanned</div>
</header>

<div class="container">
  <div class="stat-row">
    <div class="stat"><div class="value">{{ insights.avg_quality_score }}</div><div class="label">Avg Quality Score</div></div>
    <div class="stat"><div class="value">{{ insights.license_coverage_pct }}%</div><div class="label">License Coverage</div></div>
    <div class="stat"><div class="value">{{ insights.stale_repos|length }}</div><div class="label">Stale Repos</div></div>
    <div class="stat"><div class="value">{{ insights.archived_repos|length }}</div><div class="label">Archived</div></div>
    <div class="stat"><div class="value">{{ insights.ai_summaries_generated }}</div><div class="label">AI Summaries</div></div>
  </div>

  <div class="charts">
    <div class="chart-card"><h3>Quality Score by Repo</h3><div class="chart-wrap"><canvas id="scoreChart"></canvas></div></div>
    <div class="chart-card"><h3>Repo Status</h3><div class="chart-wrap"><canvas id="statusChart"></canvas></div></div>
    <div class="chart-card"><h3>Dominant Language</h3><div class="chart-wrap"><canvas id="langChart"></canvas></div></div>
    <div class="chart-card"><h3>Stars by Repo (Top 10)</h3><div class="chart-wrap"><canvas id="starsChart"></canvas></div></div>
  </div>

  <section>
    <h2>Repositories</h2>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Repo</th><th>Score</th><th>Stars</th><th>Summary</th><th>Notes</th></tr>
      </thead>
      <tbody>
      {% for repo in repositories %}
        <tr>
          <td>
            {{ repo.name }}
            {% if repo.is_stale %}<span class="badge stale">stale</span>{% endif %}
            {% if repo.is_archived %}<span class="badge archived">archived</span>{% endif %}
          </td>
          <td class="score {{ 'good' if repo.score >= 70 else ('mid' if repo.score >= 40 else 'bad') }}">{{ repo.score }}</td>
          <td>{{ repo.stars }}</td>
          <td>{{ repo.summary }}</td>
          <td class="notes">{{ repo.notes|join(', ') }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>
</div>

<script>
  Chart.defaults.color = '#8b93a1';
  Chart.defaults.font.family = "'JetBrains Mono', Menlo, Consolas, monospace";
  Chart.defaults.borderColor = '#262b33';

  const repoNames = {{ repo_names|tojson }};
  const repoScores = {{ repo_scores|tojson }};
  const statusLabels = {{ status_labels|tojson }};
  const statusCounts = {{ status_counts|tojson }};
  const langLabels = {{ lang_labels|tojson }};
  const langCounts = {{ lang_counts|tojson }};
  const topStarNames = {{ top_star_names|tojson }};
  const topStarValues = {{ top_star_values|tojson }};

  // Every card is a fixed-height .chart-wrap, so the charts fill it rather
  // than keeping their own aspect ratio and leaving dead space.
  const fill = { responsive: true, maintainAspectRatio: false };
  const noLegend = { ...fill, plugins: { legend: { display: false } } };

  new Chart(document.getElementById('scoreChart'), {
    type: 'bar',
    data: { labels: repoNames, datasets: [{ data: repoScores, backgroundColor: '#7cf29c', borderRadius: 4 }] },
    options: { ...noLegend, scales: { y: { beginAtZero: true, max: 100 } } }
  });

  new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: { labels: statusLabels, datasets: [{ data: statusCounts, backgroundColor: ['#7cf29c', '#ff9f6b', '#ff6b7a'] }] },
    options: { ...fill, plugins: { legend: { position: 'bottom' } } }
  });

  new Chart(document.getElementById('langChart'), {
    type: 'bar',
    data: { labels: langLabels, datasets: [{ data: langCounts, backgroundColor: '#ff9f6b', borderRadius: 4 }] },
    options: { ...noLegend, indexAxis: 'y', scales: { x: { ticks: { precision: 0 } } } }
  });

  new Chart(document.getElementById('starsChart'), {
    type: 'bar',
    data: { labels: topStarNames, datasets: [{ data: topStarValues, backgroundColor: '#7cf29c', borderRadius: 4 }] },
    options: noLegend
  });
</script>
</body>
</html>
